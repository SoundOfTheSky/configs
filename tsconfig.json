{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "jsx": "preserve",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": [
        "${configDir}/src/*"
      ]
    },
    "rewriteRelativeImportExtensions": true,
    "rootDir": "${configDir}/src"
  },
  "include": [
    "${configDir}/src"
  ]
}